# Copy to .env and fill in. `npm install` runs `prisma generate`, which needs
# DATABASE_URL set, so create this file before installing.
# Portal walkthrough for every Azure value below: see AZURE_SETUP.md

# ---------- Database ----------
# Any Postgres. Neon's free tier is a good fit and costs nothing.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ---------- Clerk authentication ----------
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ---------- Azure OpenAI ----------
# Deployment NAMES, not model names. You choose these when creating the
# deployments in Azure AI Foundry.
AZURE_OPENAI_RESOURCE_NAME="my-openai-resource"
AZURE_OPENAI_API_KEY="..."
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
# Must match the index's vector dimensions. Recreate the index if you change it.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# ---------- Azure AI Search ----------
AZURE_SEARCH_ENDPOINT="https://my-search-service.search.windows.net"
AZURE_SEARCH_API_KEY="..."
AZURE_SEARCH_INDEX="pdf-chunks"

# ---------- Azure Blob Storage ----------
AZURE_STORAGE_ACCOUNT_NAME="mystorageaccount"
AZURE_STORAGE_CONTAINER="pdfs"
# Optional. With a key, SAS tokens are signed locally. Without one, the app
# signs with a user delegation key via Entra ID, which is what production
# should use. Leave unset when running under a managed identity.
AZURE_STORAGE_ACCOUNT_KEY="..."

# ---------- Azure AI Document Intelligence ----------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://my-docintel.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_API_KEY="..."

# ---------- Optional tuning ----------
# Per-user chat rate limit (defaults: 20 messages per 600 seconds).
# MESSAGE_RATE_LIMIT=20
# MESSAGE_RATE_WINDOW_SECONDS=600

# Per-user upload rate limit (defaults: 5 uploads per 3600 seconds). Tighter
# than chat because each upload bills per-page document analysis.
# UPLOAD_RATE_LIMIT=5
# UPLOAD_RATE_WINDOW_SECONDS=3600
